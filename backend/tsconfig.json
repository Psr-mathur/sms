{
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"],
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo",
		"outDir": "./dist",
		"rootDir": "./src",
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "es2022",
		"skipLibCheck": true
	}
}
